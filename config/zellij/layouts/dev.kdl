layout {
		default_tab_template {
				children
				pane size=1 borderless=true {
						plugin location="zellij:compact-bar"
				}
		}
		tab name="CODE" focus=true {
				pane split_direction="vertical" {
						pane command="hx" size="68%" {
								name "Helix"
								focus true
						}
						pane split_direction="horizontal" size="32%" {
								pane command="pi" size="65%" {
										name "Pi"
								}
								pane {
										name "Shell"
								}
						}
				}
		}
		tab name="REVIEW" {
				pane command="hunk" {
						args "diff" "--watch"
						name "Hunk"
				}
		}
		tab name="GIT" {
				pane command="gitui" {
						name "GitUI"
				}
		}
}

