layout {
		default_tab_template {
				children
				pane size=1 borderless=true {
						plugin location="zellij:compact-bar"
				}
		}
		tab name="CODE" focus=true {
				pane split_direction="vertical" {
						pane command="hx" size="68%" {
								name "Helix"
								focus true
						}
						pane command="pi" size="32%"
				}
		}
		tab name="REVIEW" {
				pane command="hunk" {
						args "diff" "--watch"
						name "Hunk"
				}
		}
		tab name="GIT" {
				pane command="gitui" {
						name "GitUI"
				}
		}
		tab name="RUN" {
				pane split_direction="horizontal" {
						pane
						pane
				}
		}
}

