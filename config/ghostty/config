# Font
font-family = JetBrainsMono Nerd Font
font-feature = -calt,-liga,-dlig
font-style = Regular
font-style-bold = Bold
font-size = 16

background-opacity = 1.0
scrollback-limit = 5000
image-storage-limit = 100000000

font-thicken = true
bold-is-bright = true

# Shell
shell-integration-features = no-cursor,sudo,no-title
shell-integration = fish

# Mac
macos-titlebar-style = tabs
macos-option-as-alt = true

# Term
term = xterm-256color

# Mouse settings
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

theme = Kanagawabones

# Full screen for terminal
window-height = 80
window-width = 171

keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = alt+up=unbind
keybind = alt+down=unbind

keybind = super+t=unbind
keybind = super+w=unbind
keybind = super+n=unbind
keybind = super+d=unbind
keybind = super+shift+d=unbind
keybind = super+bracket_left=unbind
keybind = super+bracket_right=unbind